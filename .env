GOOGLE_GEMINI_BASE_URL=https://sub.mindrix.app
GEMINI_API_KEY=sk-d7492099ab2b2902df41cf042b2c20e8a98b55a2e68f098917a77efd064dd0b3
GEMINI_MODEL=gemini-3.1-pro-preview
# 2026-04-16: Removed OPENAI_API_KEY/BASE_URL — conflicts with Codex ChatGPT auth.
# Mindrix relay for Gemini uses GEMINI_* keys only.

# Claude runtime disabled: Blueprint must not call Claude CLI, Claude SDK, or
# Claude text/schema fallback paths.
BLUEPRINT_DISABLE_CLAUDE=1
BLUEPRINT_TEXT_RUNNER=codex-exec
CODEX_CODE_BACKEND=codex-exec
CODEX_SCHEMA_PRIMARY_COOLDOWN_MS=off

# SiliconFlow API
SILICONFLOW_API_KEY=sk-pdxubhitsovteroxocmmdhcytlghrvnopumfgmxxylfgempc

# Doubao (豆包) API
DOUBAO_API_KEY=197cb950-3cf3-4b30-b656-6afaa4306a7a

# Linux build server (local) — old public 120.55.70.226:3080 is a dead service
LINUX_BUILD_URL=http://127.0.0.1:18860

# Blueprint API server — workers are co-located, use localhost (was hardcoded
# default 120.55.70.226:3901).
# localhost is same-box and immune to future public-IP changes.
LINUX_BASE_URL=http://127.0.0.1:3901

# auto-7e49ed02: pin 75-min CUA timeout so ambient system env cannot override
# 75 * 60 * 1000 = 4,500,000 ms
CUA_TOTAL_TIMEOUT_MS=4500000

# auto-96cb5031: reduce recode buffer from 15 min to 12 min so the pre-recode
# guard threshold moves from 60 min to 63 min; tasks finishing a CUA round at
# ~63 min have 12 min remaining — enough for a full recode+rebuild cycle.
# 12 * 60 * 1000 = 720,000 ms
RECODE_BUFFER_MS=720000

# Codex schema fallback timeout.
# 15 * 60 * 1000 = 900,000 ms
CODEX_SCHEMA_FALLBACK_TIMEOUT_MS=900000

# Schema primary stays on Codex. Do not set SCHEMA_PRIMARY_BACKEND=claude-print.

# 2026-05-12: 确定性 LLM-替代层上线 (skill 调研 P0/P1 落地)。
# - DETERMINISTIC_TRIGGER_NORMALIZE=apply  从 spec.requiredInteractions DSL 反推 phase.trigger,
#   命中 disagree 直接覆盖 LLM 结果。测试 21/21 通过 + real-data check agree=10/11 (91%)。
#   ctx.blueprint.triggerNormalizer 存 per-phase 诊断,有事故时从 pipeline.jsonl 回溯。
# - PATCH_ANALYZER_AUTO_STUB=safe          编译失败时按 allow-list 注入 hallucinated helper stub
#   (SafeSetText / TickVisualAnimations / SafeSetActive),省一轮 Sonnet recode。
DETERMINISTIC_TRIGGER_NORMALIZE=apply
PATCH_ANALYZER_AUTO_STUB=safe

# auto-8b63e982: fidelity gate constants for cross-engine (Three.js→PlayCanvas) pipeline.
#
# FIDELITY_READY_TIMEOUT_MS — how long drivePageToPhase waits for window.__fidelityReady
# (and the PlayCanvas/canvas-pixel fallback signals) before falling through to the
# secondary canvas-black guard.
# auto-8b63e982 (v2): raised from 20 s → 60 s. Slow CI hosts need 25–35 s for
# PlayCanvas/Luna WebGL builds to fully initialize; 20 s was still insufficient and
# produced black-frame captures with ~100 % pixel divergence on every phase.
# The secondary canvas-black guard (FIDELITY_CANVAS_BLACK_GUARD_MS below) provides
# an additional safety net after this window expires.
# Override here for unusually fast hosts (e.g. '30000') or very slow hosts ('90000').
FIDELITY_READY_TIMEOUT_MS=60000

# FIDELITY_CANVAS_BLACK_GUARD_MS — secondary guard timeout after the primary
# FIDELITY_READY_TIMEOUT_MS window expires. drivePageToPhase makes one more targeted
# canvas-pixel-only poll for up to this many ms before accepting a potentially-black
# frame. Prevents black-frame captures on hosts where the build initializes in
# 25–35 s but the primary window was configured too low.
# Default: 20000 (20 s). Set to '0' to disable the secondary guard entirely.
FIDELITY_CANVAS_BLACK_GUARD_MS=20000

# FIDELITY_PIXEL_GATE_THRESHOLD_PERCENT — per-phase pixel-diff % above which the gate blocks.
# Raised from 5 % → 60 % to account for inherent cross-engine pixel spread: a correctly-ported
# Three.js→PlayCanvas game will naturally differ 30–60 % pixel-level due to different shaders,
# anti-aliasing, and lighting models. The previous 5 % gate was unpassable even for correct builds.
# Set to '0' to bypass the pixel gate entirely, or lower (e.g. '30') once a same-engine baseline
# is established.
FIDELITY_PIXEL_GATE_THRESHOLD_PERCENT=60
