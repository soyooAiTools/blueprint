# 2026-04-16: Removed OPENAI_API_KEY/BASE_URL/CODEX_API_KEY — conflicts with
# Codex ChatGPT auth. Codex uses ~/.codex/auth.json (chatgpt mode).
GEMINI_API_KEY=sk-d7492099ab2b2902df41cf042b2c20e8a98b55a2e68f098917a77efd064dd0b3
GOOGLE_GEMINI_BASE_URL=https://sub.mindrix.app
GEMINI_MODEL=gemini-3.1-pro-preview
USE_CODEX_REVIEW=true
LINUX_BASE_URL=http://127.0.0.1:3901
LINUX_BUILD_URL=http://127.0.0.1:18860
NO_PROXY=localhost,127.0.0.1,120.55.70.226,crs.mindrix.app,*.mindrix.app,*.volces.com,*.siliconflow.cn
no_proxy=localhost,127.0.0.1,120.55.70.226,crs.mindrix.app,*.mindrix.app,*.volces.com,*.siliconflow.cn

# auto-7e49ed02: pin 75-min CUA timeout so ambient system env cannot override
# 75 * 60 * 1000 = 4,500,000 ms
CUA_TOTAL_TIMEOUT_MS=4500000

# auto-96cb5031: reduce recode buffer from 15 min to 12 min so the pre-recode
# guard threshold moves from 60 min to 63 min; tasks finishing a CUA round at
# ~63 min have 12 min remaining — enough for a full recode+rebuild cycle.
# 12 * 60 * 1000 = 720,000 ms
RECODE_BUFFER_MS=720000

# Codex schema fallback timeout.
# 15 * 60 * 1000 = 900,000 ms
CODEX_SCHEMA_FALLBACK_TIMEOUT_MS=900000

# Claude runtime disabled: do not route schema/text/codegen through Claude.
BLUEPRINT_DISABLE_CLAUDE=1
BLUEPRINT_TEXT_RUNNER=codex-exec
CODEX_CODE_BACKEND=codex-exec
CODEX_SCHEMA_PRIMARY_COOLDOWN_MS=off

# 2026-05-12: worker/.env 在当前 linux-worker-client.js (line 15) 下不被加载 —
# 实际生效的是根 /opt/blueprint-editor/.env (path.join(__dirname,'..','.env'))。
# DETERMINISTIC_TRIGGER_NORMALIZE / PATCH_ANALYZER_AUTO_STUB 已移到根 .env。
