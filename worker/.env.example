# Worker 环境变量配置（复制为 .env 使用）
# 所有 key 和代理在此配置，worker-client.js 启动时自动加载
# 子进程（luna-agent.js 等）通过 process.env 自动继承

# AI API Keys
OPENAI_API_KEY=sk-proj-xxx
GEMINI_API_KEY=AIza-xxx

# AI 编码模型（可选，默认 claude-opus-4-6-20250904）
# LLM_MODEL_GENERATE=claude-opus-4-6-20250904
# LLM_MODEL_FIX=claude-opus-4-6-20250904

# 网络代理
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
http_proxy=http://127.0.0.1:7890
