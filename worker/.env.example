# Worker 环境变量配置
# 复制为 .env 使用：copy .env.example .env
# worker-client.js 启动时通过 dotenv 加载，所有子进程自动继承

# === AI API Keys ===
OPENAI_API_KEY=sk-proj-xxx
GEMINI_API_KEY=AIza-xxx

# === AI 编码模型（可选，默认见 worker-coder.js）===
# LLM_API_KEY=cr_xxx          # 中转 API key（默认已内置）
# LLM_MODEL_GENERATE=claude-opus-4-6
# LLM_MODEL_FIX=claude-opus-4-6

# === 网络代理 ===
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
http_proxy=http://127.0.0.1:7890
