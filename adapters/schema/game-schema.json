{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blueprint-editor.local/game-schema.json",
  "title": "Blueprint Game Schema",
  "description": "Schema for AI-generated playable ad game definitions",
  "type": "object",
  "required": ["gameConfig", "entities", "phases"],
  "additionalProperties": false,
  "properties": {
    "gameConfig": {
      "type": "object",
      "required": ["cameraBackground", "groundColor", "moveSpeed", "collectRange", "maxCarry"],
      "additionalProperties": false,
      "properties": {
        "cameraBackground": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB color [r, g, b] for camera background"
        },
        "groundColor": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "RGB color [r, g, b] for ground plane"
        },
        "moveSpeed": {
          "type": "number",
          "minimum": 0,
          "description": "Player movement speed"
        },
        "collectRange": {
          "type": "number",
          "minimum": 0,
          "description": "Range within which player can collect resources"
        },
        "maxCarry": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items the player can carry"
        },
        "collectCooldown": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2.0,
          "default": 0.3,
          "description": "Seconds between consecutive collect actions (global cooldown). Lower = faster resource accumulation, higher = player must wait between pickups."
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/resource"
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/form"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/phase"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/npc"
      }
    },
    "customLogic": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Custom logic description for Claude Code to implement"
      }
    }
  },
  "definitions": {
    "entity": {
      "type": "object",
      "required": ["name", "chineseName", "pool", "initPos", "scale"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique entity name (PascalCase, English, used as C# variable)"
        },
        "chineseName": {
          "type": "string",
          "minLength": 1,
          "description": "中文显示名,挂在 3D 场景实体头顶的世界标签。如 ForgeWorkshop -> '锻造间', SpaceJunk -> '太空垃圾'"
        },
        "showLabel": {
          "type": "boolean",
          "default": true,
          "description": "是否在场景中显示中文标签。玩家载具/货币飘字/CTA 按钮应设 false,目标建筑/可采集资源应设 true"
        },
        "pool": {
          "type": "string",
          "pattern": "^__Pool_[A-Z][a-z]+_[A-Z][a-z]+_\\d{2}$",
          "description": "Asset pool identifier, e.g. __Pool_Nature_Tree_01"
        },
        "initPos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Initial position [x, y, z]"
        },
        "scale": {
          "type": "number",
          "minimum": 0.3,
          "description": "Scale factor, must be >= 0.3"
        },
        "showInPhase": {
          "type": "string",
          "description": "Phase ID when this entity first becomes visible"
        },
        "terminalState": {
          "type": "integer",
          "description": "Terminal state index for state machine entities"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name", "entity", "convertRatio"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Resource type name"
        },
        "entity": {
          "type": "string",
          "description": "Entity name that drops this resource"
        },
        "convertRatio": {
          "type": "integer",
          "minimum": 0,
          "description": "How many raw resources convert to one processed unit"
        },
        "maxStock": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum stock limit"
        }
      }
    },
    "form": {
      "type": "object",
      "required": ["formId", "pool", "moveSpeed", "collectRange", "collectPower", "carryCapacity", "scale"],
      "additionalProperties": false,
      "properties": {
        "formId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique form identifier"
        },
        "pool": {
          "type": "string",
          "description": "Pool object name for this form"
        },
        "moveSpeed": {
          "type": "number",
          "minimum": 0,
          "description": "Movement speed in this form"
        },
        "collectRange": {
          "type": "number",
          "minimum": 0,
          "description": "Collection range in this form"
        },
        "collectPower": {
          "type": "number",
          "minimum": 0,
          "description": "Collection power in this form"
        },
        "carryCapacity": {
          "type": "integer",
          "minimum": 1,
          "description": "Carry capacity in this form"
        },
        "scale": {
          "type": "number",
          "minimum": 0.3,
          "description": "Scale factor for this form"
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "resource_collected",
            "entity_state_reached",
            "near_entity",
            "click_entity",
            "all_built",
            "enemy_defeated",
            "timer",
            "compound"
          ]
        },
        "entity": {
          "type": "string",
          "description": "Target entity name (for entity-related triggers)"
        },
        "resource": {
          "type": "string",
          "description": "Target resource name (for resource_collected)"
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Required amount (for resource_collected)"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Required count (for enemy_defeated)"
        },
        "state": {
          "type": "integer",
          "description": "Target state index (for entity_state_reached)"
        },
        "range": {
          "type": "number",
          "minimum": 0,
          "description": "Proximity range (for near_entity)"
        },
        "seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Timer duration in seconds (for timer)"
        },
        "operator": {
          "type": "string",
          "enum": ["and", "or"],
          "description": "Logical operator for compound triggers"
        },
        "triggers": {
          "type": "array",
          "items": { "$ref": "#/definitions/trigger" },
          "description": "Sub-triggers for compound type"
        }
      },
      "additionalProperties": false
    },
    "phaseAction": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["set_entity_state", "add_resource", "switch_form", "show_floating_text", "set_guide", "spawn_enemies"],
          "description": "Action identifier"
        },
        "entity": { "type": "string", "description": "Target entity name" },
        "state": { "type": "integer", "description": "Target state value" },
        "resource": { "type": "string", "description": "Resource name" },
        "amount": { "type": "integer", "description": "Resource amount" },
        "formIndex": { "type": "integer", "description": "Form index to switch to" },
        "text": { "type": "string", "description": "Display text" },
        "color": { "type": "string", "description": "Color name (e.g. yellow, red)" },
        "count": { "type": "integer", "description": "Spawn count" }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["phaseId", "showEntities", "trigger"],
      "additionalProperties": false,
      "properties": {
        "phaseId": {
          "type": "string",
          "minLength": 1,
          "description": "Unique phase identifier"
        },
        "showEntities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Entity names to show when this phase starts"
        },
        "hideEntities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Entity names to hide when this phase starts"
        },
        "guideText": {
          "type": "string",
          "description": "Player instruction text"
        },
        "trigger": {
          "$ref": "#/definitions/trigger"
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/phaseStep" },
          "description": "Source storyboard2html phase step sequence used to preserve intra-phase target order"
        },
        "onEnter": {
          "type": "array",
          "items": { "$ref": "#/definitions/phaseAction" },
          "description": "Actions executed when phase starts"
        },
        "onComplete": {
          "type": "array",
          "items": { "$ref": "#/definitions/phaseAction" },
          "description": "Actions executed when phase completes"
        }
      }
    },
    "phaseStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer" },
        "target": { "type": "string" },
        "label": { "type": "string" },
        "gain": { "type": "string" },
        "spend": { "type": "string" },
        "amount": { "type": "number" },
        "cost": { "type": "number" },
        "setEntity": { "type": "string" },
        "state": { "type": "number" },
        "damage": { "type": "boolean" },
        "shipLevel": { "type": "number" },
        "tool": { "type": "string" }
      }
    },
    "npc": {
      "type": "object",
      "required": ["entity", "template"],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string",
          "description": "Entity name this NPC is attached to"
        },
        "template": {
          "type": "string",
          "enum": [
            "patrol",
            "chase_attack",
            "static_target",
            "ranged_shooter",
            "spawner",
            "wander",
            "evade",
            "defend",
            "circle",
            "group_attack",
            "flee_on_hit",
            "boss_multiphase"
          ],
          "description": "NPC behavior template"
        },
        "params": {
          "type": "object",
          "description": "Template-specific parameters",
          "additionalProperties": true
        }
      }
    }
  }
}
